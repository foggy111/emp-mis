{
  "info": {
    "name": "emp-mis",
    "description": "EMP 员工管理 MIS。导入 ApiFox 后把 baseUrl 设为 http://localhost:8080（应用上下文为 /）。先执行登录并保存 Cookie。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "01 认证",
      "item": [
        {
          "name": "注册",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/register",
            "description": "重复执行时期望 code=500，消息为用户名已存在。",
            "body": {
              "mode": "raw",
              "raw": "{\"username\": \"student\", \"password\": \"123456\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "pm.test('业务码', function () {",
                  "    pm.expect(json.code).to.eql(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "登录",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/login",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\"username\": \"admin\", \"password\": \"123456\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "pm.test('业务码', function () {",
                  "    pm.expect(json.code).to.eql(200);",
                  "});",
                  "pm.test('返回用户名', function () { pm.expect(pm.response.json().data).to.eql('admin'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "错误密码",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/login",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\"username\": \"admin\", \"password\": \"000000\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "pm.test('业务码', function () {",
                  "    pm.expect(json.code).to.eql(500);",
                  "});",
                  "pm.test('提示', function () {",
                  "    pm.expect(json.message).to.eql(\"用户名或密码错误\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
